DATABASE_URL=postgresql://novaseguro:novaseguro_dev_pw@localhost:5432/novaseguro
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
JWT_SECRET=change-me-in-every-environment
COOKIE_SECURE=false
# Vazio = cookie host-only (um domínio só). Para multi-tenant por
# subdomínio em produção, use ".suaempresa.com" (com o ponto à frente).
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000
# Para liberar qualquer subdomínio em produção, ex.: ^https://.*\.suaempresa\.com$
CORS_ORIGIN_REGEX=
# Tenant usado quando a requisição não indica subdomínio (localhost, IP).
DEFAULT_TENANT_SLUG=novaseguro
STORAGE_DIR=./data/documentos
