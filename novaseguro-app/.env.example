# Copie este arquivo para ".env" na raiz do projeto antes de rodar
# `docker compose up`. Esse .env é lido automaticamente pelo Docker Compose
# e repassado para os serviços abaixo.

# --- Postgres ---
POSTGRES_USER=novaseguro
POSTGRES_PASSWORD=novaseguro_dev_pw
POSTGRES_DB=novaseguro

# --- Segredo compartilhado entre frontend e backend para o JWT de sessão ---
JWT_SECRET=change-me-in-every-environment
COOKIE_SECURE=false

# --- OpenAI (obrigatório para o assistente de IA responder de verdade) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
